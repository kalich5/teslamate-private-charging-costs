# Copy to .env and adjust.

# Password for the web UI (user name: admin, or set WEB_USER).
# Without it, anyone who can reach the page can change your tariffs.
WEB_PASSWORD=change-me
# WEB_USER=admin
# Keeps you logged in across restarts; any long random string.
# SECRET_KEY=

# TeslaMate database — same variable names as in TeslaMate.
DATABASE_PASS=your-teslamate-db-password
# DATABASE_HOST=database
# DATABASE_PORT=5432
# DATABASE_NAME=teslamate
# DATABASE_USER=teslamate

# Docker network of your TeslaMate stack (see `docker network ls`)
TESLAMATE_NETWORK=teslamate_default

# Host port of the web UI
# PRIVATE_COSTS_PORT=4001
