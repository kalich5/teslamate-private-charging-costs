#, python-format
msgid "%(days)s: '%(price)s' is not a valid price."
msgstr "%(days)s: '%(price)s' geçerli bir fiyat değil."

#, python-format
msgid "%(field)s: '%(value)s' is not a valid number."
msgstr "%(field)s: '%(value)s' geçerli bir sayı değil."

msgid "0 = only when you click “Calculate and save”."
msgstr "0 = yalnızca “Hesapla ve kaydet”e tıkladığınızda."

msgid "Add location"
msgstr "Konum ekle"

msgid "Add time block"
msgstr "Zaman dilimi ekle"

msgid "Another run is in progress, try again in a moment."
msgstr "Başka bir çalışma sürüyor, biraz sonra tekrar deneyin."

msgid "Automatic runs are off."
msgstr "Otomatik çalıştırma kapalı."

msgid "Back"
msgstr "Geri"

msgid "By default the language of your browser is used, as in TeslaMate."
msgstr "TeslaMate'te olduğu gibi varsayılan olarak tarayıcınızın dili kullanılır."

msgid "Calculate and save"
msgstr "Hesapla ve kaydet"

msgid ""
"Calculates the cost of every finished charge at your locations that has no cost yet. Existing "
"costs are never changed."
msgstr ""
"Konumlarınızda henüz tutarı olmayan her tamamlanmış şarjın tutarını hesaplar. Mevcut tutarlar "
"asla değiştirilmez."

msgid "Cancel"
msgstr "İptal"

#, python-format
msgid "Cannot connect to the TeslaMate database: %(error)s"
msgstr "TeslaMate veritabanına bağlanılamıyor: %(error)s"

#, python-format
msgid "Cannot read sessions from the TeslaMate database: %(error)s"
msgstr "TeslaMate veritabanından şarjlar okunamıyor: %(error)s"

msgid "Charges"
msgstr "Şarjlar"

#, python-format
msgid "Charges to be updated: %(n)s"
msgstr "Güncellenecek şarjlar: %(n)s"

msgid "Charging Costs"
msgstr "Şarj Tutarları"

msgid "Config is empty or not a mapping."
msgstr "Yapılandırma boş veya geçersiz."

#, python-format
msgid "Configuration problem: %(problem)s"
msgstr "Yapılandırma sorunu: %(problem)s"

msgid "Coordinates are out of range."
msgstr "Koordinatlar aralık dışında."

msgid "Cost"
msgstr "Tutar"

msgid "Costs are converted to this currency using the ECB rate of the charging day."
msgstr "Tutarlar, şarj gününün ECB kuru ile bu para birimine çevrilir."

msgid "Costs saved"
msgstr "Tutarlar kaydedildi"

msgid "Could not load geo-fences from TeslaMate."
msgstr "TeslaMate'ten coğrafi sınırlar yüklenemedi."

msgid "Currency in TeslaMate"
msgstr "TeslaMate para birimi"

msgid "Currency must be a 3-letter code, e.g. CZK."
msgstr "Para birimi 3 harfli bir kod olmalıdır, ör. TRY."

msgid "Currency of your bill"
msgstr "Faturanızın para birimi"

msgid "Database"
msgstr "Veritabanı"

msgid "Delete"
msgstr "Sil"

#, python-format
msgid "Delete %(name)s? Costs already written stay in TeslaMate."
msgstr "%(name)s silinsin mi? Önceden yazılmış tutarlar TeslaMate'te kalır."

msgid "Edit"
msgstr "Düzenle"

msgid "End"
msgstr "Bitiş"

#, python-format
msgid "Errors: %(n)s"
msgstr "Hatalar: %(n)s"

msgid "From"
msgstr "Başlangıç"

msgid "Geo-Fences"
msgstr "Coğrafi-Sınırlar"

msgid "Host"
msgstr "Sunucu"

msgid "Interval must be a number ≥ 0."
msgstr "Aralık ≥ 0 olan bir sayı olmalıdır."

#, python-format
msgid "Invalid configuration: %(error)s"
msgstr "Geçersiz yapılandırma: %(error)s"

msgid "Invalid or expired form token — reload the page and try again."
msgstr "Form belirteci geçersiz veya süresi dolmuş — sayfayı yenileyip tekrar deneyin."

msgid "Language"
msgstr "Dil"

msgid "Last 100 finished charges. kWh = energy taken from the grid."
msgstr "Son 100 tamamlanmış şarj. kWh = şebekeden çekilen enerji."

#, python-format
msgid "Last run: %(time)s"
msgstr "Son çalışma: %(time)s"

msgid "Latitude"
msgstr "Enlem"

msgid "Loading…"
msgstr "Yükleniyor…"

msgid "Location"
msgstr "Konum"

#, python-format
msgid "Location '%(name)s' deleted."
msgstr "'%(name)s' konumu silindi."

#, python-format
msgid ""
"Location '%(name)s' has no timezone. Set a default timezone (e.g. Europe/Prague) or one for the "
"location."
msgstr ""
"'%(name)s' konumunun saat dilimi yok. Varsayılan bir saat dilimi (ör. Europe/Istanbul) veya "
"konuma özel bir saat dilimi ayarlayın."

#, python-format
msgid "Location '%(name)s' saved."
msgstr "'%(name)s' konumu kaydedildi."

#, python-format
msgid ""
"Location '%(name)s', %(days)s: block %(block)s must start before it ends. Split blocks crossing "
"midnight into two (…–24:00 and 00:00–…)."
msgstr ""
"'%(name)s' konumu, %(days)s: %(block)s dilimi bitmeden önce başlamalıdır. Gece yarısını geçen "
"dilimleri ikiye bölün (…–24:00 ve 00:00–…)."

#, python-format
msgid "Location '%(name)s', %(days)s: invalid block %(block)s. Expected from and to as HH:MM and a price."
msgstr ""
"'%(name)s' konumu, %(days)s: geçersiz dilim %(block)s. SS:DD biçiminde başlangıç ve bitiş ile bir"
" fiyat bekleniyor."

#, python-format
msgid "Location '%(name)s', %(days)s: negative price in block %(block)s."
msgstr "'%(name)s' konumu, %(days)s: %(block)s diliminde negatif fiyat."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariff after %(time)s (the last block must end at 24:00)."
msgstr "'%(name)s' konumu, %(days)s: %(time)s sonrasında tarife yok (son dilim 24:00'te bitmelidir)."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariff between %(start)s and %(end)s."
msgstr "'%(name)s' konumu, %(days)s: %(start)s ile %(end)s arasında tarife yok."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariffs defined."
msgstr "'%(name)s' konumu, %(days)s: tanımlı tarife yok."

#, python-format
msgid "Location '%(name)s', %(days)s: overlapping blocks around %(time)s."
msgstr "'%(name)s' konumu, %(days)s: %(time)s civarında çakışan dilimler."

#, python-format
msgid "Location '%(name)s': missing '%(key)s'."
msgstr "'%(name)s' konumu: '%(key)s' eksik."

#, python-format
msgid "Location '%(name)s': missing 'timezone'."
msgstr "'%(name)s' konumu: saat dilimi eksik."

#, python-format
msgid "Location '%(name)s': unknown timezone '%(tz)s'."
msgstr "'%(name)s' konumu: bilinmeyen saat dilimi '%(tz)s'."

msgid "Location names must be unique."
msgstr "Konum adları benzersiz olmalıdır."

msgid "Locations"
msgstr "Konumlar"

msgid "Login required"
msgstr "Oturum açmanız gerekiyor"

msgid "Longitude"
msgstr "Boylam"

#, python-format
msgid "Missing '%(key)s'."
msgstr "'%(key)s' eksik."

msgid "Monday – Friday"
msgstr "Pazartesi – Cuma"

msgid "Name"
msgstr "İsim"

msgid "Name is required."
msgstr "İsim gerekli."

msgid "New location"
msgstr "Yeni konum"

#, python-format
msgid "Next run: %(time)s"
msgstr "Sonraki çalışma: %(time)s"

msgid "No geo-fences in TeslaMate"
msgstr "TeslaMate'te coğrafi sınır yok"

msgid "No locations yet. Add your home (or any private charger) and its electricity tariff."
msgstr "Henüz konum yok. Evinizi (veya herhangi bir özel şarj noktasını) ve elektrik tarifesini ekleyin."

#, python-format
msgid "No password set — anyone who can reach this page can change your tariffs. Set %(var)s."
msgstr ""
"Parola ayarlanmamış — bu sayfaya erişebilen herkes tarifelerinizi değiştirebilir. %(var)s "
"ayarlayın."

msgid "No price"
msgstr "Fiyat yok"

msgid "Overlap"
msgstr "Çakışma"

msgid "Per kWh"
msgstr "kWh başına"

msgid "Pick a TeslaMate geo-fence to fill in name, coordinates and radius."
msgstr "Ad, koordinatlar ve yarıçapı doldurmak için bir TeslaMate coğrafi sınırı seçin."

msgid "Preview"
msgstr "Önizleme"

msgid "Private charging"
msgstr "Özel şarj"

msgid "Radius"
msgstr "Yarıçap"

msgid "Radius must be positive."
msgstr "Yarıçap pozitif olmalıdır."

msgid "Remove"
msgstr "Kaldır"

msgid "Run automatically every (hours)"
msgstr "Otomatik çalıştırma aralığı (saat)"

#, python-format
msgid "Runs automatically every %(hours)s h."
msgstr "Her %(hours)s saatte bir otomatik olarak çalışır."

msgid "Same as Monday – Friday"
msgstr "Pazartesi – Cuma ile aynı"

msgid "Saturday – Sunday"
msgstr "Cumartesi – Pazar"

msgid "Save"
msgstr "Kaydet"

msgid "Save these costs"
msgstr "Bu tutarları kaydet"

#, python-format
msgid "Set with environment variables (%(vars)s), the same as in TeslaMate."
msgstr "TeslaMate'te olduğu gibi ortam değişkenleriyle (%(vars)s) ayarlanır."

msgid "Settings"
msgstr "Ayarlar"

msgid "Settings saved."
msgstr "Ayarlar kaydedildi."

msgid "Start"
msgstr "Başlangıç"

msgid "Tariff times are local times in this time zone. Summer time is handled automatically."
msgstr "Tarife saatleri bu saat dilimindeki yerel saatlerdir. Yaz saati otomatik olarak dikkate alınır."

msgid "TeslaMate database"
msgstr "TeslaMate veritabanı"

msgid "Time zone"
msgstr "Saat dilimi"

msgid ""
"Times are 24-hour (HH:MM); the last block ends at 24:00. A block over midnight (e.g. 22:00–06:00)"
" is entered as 22:00–24:00 and 00:00–06:00."
msgstr ""
"Saatler 24 saat biçimindedir (SS:DD); son dilim 24:00'te biter. Gece yarısını geçen bir dilim "
"(ör. 22:00–06:00) 22:00–24:00 ve 00:00–06:00 olarak girilir."

msgid "To"
msgstr "Bitiş"

msgid "Unavailable"
msgstr "Mevcut değil"

#, python-format
msgid "Unexpected error: %(error)s"
msgstr "Beklenmeyen hata: %(error)s"

#, python-format
msgid "Unknown timezone '%(tz)s'."
msgstr "Bilinmeyen saat dilimi '%(tz)s'."

#, python-format
msgid "Updated: %(n)s"
msgstr "Güncellenen: %(n)s"

msgid "User"
msgstr "Kullanıcı"

msgid "Web App"
msgstr "Web Uygulaması"

msgid "Write costs to TeslaMate now?"
msgstr "Tutarlar şimdi TeslaMate'e yazılsın mı?"

msgid "pending"
msgstr "bekliyor"

msgid "— choose —"
msgstr "— seçin —"

