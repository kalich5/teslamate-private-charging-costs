#, python-format
msgid "%(days)s: '%(price)s' is not a valid price."
msgstr "%(days)s: «%(price)s» no és un preu vàlid."

#, python-format
msgid "%(field)s: '%(value)s' is not a valid number."
msgstr "%(field)s: «%(value)s» no és un número vàlid."

msgid "0 = only when you click “Calculate and save”."
msgstr "0 = només quan feu clic a «Calcula i desa»."

msgid "Add location"
msgstr "Afegeix una ubicació"

msgid "Add time block"
msgstr "Afegeix un tram horari"

msgid "Another run is in progress, try again in a moment."
msgstr "Ja hi ha una execució en curs; torneu-ho a provar d'aquí a un moment."

msgid "Automatic runs are off."
msgstr "Les execucions automàtiques estan desactivades."

msgid "Back"
msgstr "Enrere"

msgid "By default the language of your browser is used, as in TeslaMate."
msgstr "Per defecte s'utilitza l'idioma del navegador, com a TeslaMate."

msgid "Calculate and save"
msgstr "Calcula i desa"

msgid ""
"Calculates the cost of every finished charge at your locations that has no cost yet. Existing "
"costs are never changed."
msgstr ""
"Calcula el cost de cada càrrega finalitzada a les vostres ubicacions que encara no en té. Els "
"costos existents no es modifiquen mai."

msgid "Cancel"
msgstr "Cancel·la"

#, python-format
msgid "Cannot connect to the TeslaMate database: %(error)s"
msgstr "No es pot connectar a la base de dades de TeslaMate: %(error)s"

#, python-format
msgid "Cannot read sessions from the TeslaMate database: %(error)s"
msgstr "No es poden llegir les càrregues de la base de dades de TeslaMate: %(error)s"

msgid "Charges"
msgstr "Càrregues"

#, python-format
msgid "Charges to be updated: %(n)s"
msgstr "Càrregues per actualitzar: %(n)s"

msgid "Charging Costs"
msgstr "Despeses de càrrega"

msgid "Config is empty or not a mapping."
msgstr "La configuració és buida o no és vàlida."

#, python-format
msgid "Configuration problem: %(problem)s"
msgstr "Problema de configuració: %(problem)s"

msgid "Coordinates are out of range."
msgstr "Les coordenades estan fora de rang."

msgid "Cost"
msgstr "Cost"

msgid "Costs are converted to this currency using the ECB rate of the charging day."
msgstr "Els costos es converteixen a aquesta moneda amb el canvi del BCE del dia de la càrrega."

msgid "Costs saved"
msgstr "Costos desats"

msgid "Could not load geo-fences from TeslaMate."
msgstr "No s'han pogut carregar les geotanques de TeslaMate."

msgid "Currency in TeslaMate"
msgstr "Moneda a TeslaMate"

msgid "Currency must be a 3-letter code, e.g. CZK."
msgstr "La moneda ha de ser un codi de 3 lletres, p. ex. EUR."

msgid "Currency of your bill"
msgstr "Moneda de la factura"

msgid "Database"
msgstr "Base de dades"

msgid "Delete"
msgstr "Elimina"

#, python-format
msgid "Delete %(name)s? Costs already written stay in TeslaMate."
msgstr "Voleu eliminar %(name)s? Els costos ja escrits es mantenen a TeslaMate."

msgid "Edit"
msgstr "Edita"

msgid "End"
msgstr "Fi"

#, python-format
msgid "Errors: %(n)s"
msgstr "Errors: %(n)s"

msgid "From"
msgstr "De"

msgid "Geo-Fences"
msgstr "Geotanques"

msgid "Host"
msgstr "Servidor"

msgid "Interval must be a number ≥ 0."
msgstr "L'interval ha de ser un número ≥ 0."

#, python-format
msgid "Invalid configuration: %(error)s"
msgstr "Configuració no vàlida: %(error)s"

msgid "Invalid or expired form token — reload the page and try again."
msgstr ""
"El testimoni del formulari no és vàlid o ha caducat; torneu a carregar la pàgina i proveu-ho de "
"nou."

msgid "Language"
msgstr "Idioma"

msgid "Last 100 finished charges. kWh = energy taken from the grid."
msgstr "Les darreres 100 càrregues finalitzades. kWh = energia presa de la xarxa."

#, python-format
msgid "Last run: %(time)s"
msgstr "Darrera execució: %(time)s"

msgid "Latitude"
msgstr "Latitud"

msgid "Loading…"
msgstr "S'està carregant…"

msgid "Location"
msgstr "Ubicació"

#, python-format
msgid "Location '%(name)s' deleted."
msgstr "S'ha eliminat la ubicació «%(name)s»."

#, python-format
msgid ""
"Location '%(name)s' has no timezone. Set a default timezone (e.g. Europe/Prague) or one for the "
"location."
msgstr ""
"La ubicació «%(name)s» no té zona horària. Definiu una zona horària per defecte (p. ex. "
"Europe/Madrid) o una per a la ubicació."

#, python-format
msgid "Location '%(name)s' saved."
msgstr "S'ha desat la ubicació «%(name)s»."

#, python-format
msgid ""
"Location '%(name)s', %(days)s: block %(block)s must start before it ends. Split blocks crossing "
"midnight into two (…–24:00 and 00:00–…)."
msgstr ""
"Ubicació «%(name)s», %(days)s: el tram %(block)s ha de començar abans d'acabar. Dividiu els trams"
" que passen la mitjanit en dos (…–24:00 i 00:00–…)."

#, python-format
msgid "Location '%(name)s', %(days)s: invalid block %(block)s. Expected from and to as HH:MM and a price."
msgstr ""
"Ubicació «%(name)s», %(days)s: tram no vàlid %(block)s. Cal una hora d'inici i de fi (HH:MM) i un"
" preu."

#, python-format
msgid "Location '%(name)s', %(days)s: negative price in block %(block)s."
msgstr "Ubicació «%(name)s», %(days)s: preu negatiu al tram %(block)s."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariff after %(time)s (the last block must end at 24:00)."
msgstr ""
"Ubicació «%(name)s», %(days)s: no hi ha tarifa després de les %(time)s (l'últim tram ha d'acabar "
"a les 24:00)."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariff between %(start)s and %(end)s."
msgstr "Ubicació «%(name)s», %(days)s: no hi ha tarifa entre les %(start)s i les %(end)s."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariffs defined."
msgstr "Ubicació «%(name)s», %(days)s: no hi ha tarifes definides."

#, python-format
msgid "Location '%(name)s', %(days)s: overlapping blocks around %(time)s."
msgstr "Ubicació «%(name)s», %(days)s: trams solapats al voltant de les %(time)s."

#, python-format
msgid "Location '%(name)s': missing '%(key)s'."
msgstr "Ubicació «%(name)s»: falta «%(key)s»."

#, python-format
msgid "Location '%(name)s': missing 'timezone'."
msgstr "Ubicació «%(name)s»: falta la zona horària."

#, python-format
msgid "Location '%(name)s': unknown timezone '%(tz)s'."
msgstr "Ubicació «%(name)s»: zona horària desconeguda «%(tz)s»."

msgid "Location names must be unique."
msgstr "Els noms de les ubicacions han de ser únics."

msgid "Locations"
msgstr "Ubicacions"

msgid "Login required"
msgstr "Cal iniciar sessió"

msgid "Longitude"
msgstr "Longitud"

#, python-format
msgid "Missing '%(key)s'."
msgstr "Falta «%(key)s»."

msgid "Monday – Friday"
msgstr "Dilluns – divendres"

msgid "Name"
msgstr "Nom"

msgid "Name is required."
msgstr "Cal un nom."

msgid "New location"
msgstr "Nova ubicació"

#, python-format
msgid "Next run: %(time)s"
msgstr "Propera execució: %(time)s"

msgid "No geo-fences in TeslaMate"
msgstr "No hi ha geotanques a TeslaMate"

msgid "No locations yet. Add your home (or any private charger) and its electricity tariff."
msgstr ""
"Encara no hi ha ubicacions. Afegiu casa vostra (o qualsevol carregador privat) i la seva tarifa "
"elèctrica."

#, python-format
msgid "No password set — anyone who can reach this page can change your tariffs. Set %(var)s."
msgstr ""
"No hi ha cap contrasenya: qualsevol persona que accedeixi a aquesta pàgina pot canviar les "
"tarifes. Definiu %(var)s."

msgid "No price"
msgstr "Sense preu"

msgid "Overlap"
msgstr "Solapament"

msgid "Per kWh"
msgstr "Per kWh"

msgid "Pick a TeslaMate geo-fence to fill in name, coordinates and radius."
msgstr "Trieu una geotanca de TeslaMate per omplir el nom, les coordenades i el radi."

msgid "Preview"
msgstr "Previsualitza"

msgid "Private charging"
msgstr "Càrrega privada"

msgid "Radius"
msgstr "Radi"

msgid "Radius must be positive."
msgstr "El radi ha de ser positiu."

msgid "Remove"
msgstr "Treu"

msgid "Run automatically every (hours)"
msgstr "Executa automàticament cada (hores)"

#, python-format
msgid "Runs automatically every %(hours)s h."
msgstr "S'executa automàticament cada %(hours)s h."

msgid "Same as Monday – Friday"
msgstr "Igual que de dilluns a divendres"

msgid "Saturday – Sunday"
msgstr "Dissabte – diumenge"

msgid "Save"
msgstr "Desa"

msgid "Save these costs"
msgstr "Desa aquests costos"

#, python-format
msgid "Set with environment variables (%(vars)s), the same as in TeslaMate."
msgstr "Es defineix amb variables d'entorn (%(vars)s), igual que a TeslaMate."

msgid "Settings"
msgstr "Paràmetres"

msgid "Settings saved."
msgstr "Paràmetres desats."

msgid "Start"
msgstr "Inici"

msgid "Tariff times are local times in this time zone. Summer time is handled automatically."
msgstr ""
"Les hores de les tarifes són hores locals d'aquesta zona horària. L'horari d'estiu es gestiona "
"automàticament."

msgid "TeslaMate database"
msgstr "Base de dades de TeslaMate"

msgid "Time zone"
msgstr "Zona horària"

msgid ""
"Times are 24-hour (HH:MM); the last block ends at 24:00. A block over midnight (e.g. 22:00–06:00)"
" is entered as 22:00–24:00 and 00:00–06:00."
msgstr ""
"Les hores són en format de 24 hores (HH:MM); l'últim tram acaba a les 24:00. Un tram que passa la"
" mitjanit (p. ex. 22:00–06:00) s'introdueix com a 22:00–24:00 i 00:00–06:00."

msgid "To"
msgstr "Fins a"

msgid "Unavailable"
msgstr "No disponible"

#, python-format
msgid "Unexpected error: %(error)s"
msgstr "Error inesperat: %(error)s"

#, python-format
msgid "Unknown timezone '%(tz)s'."
msgstr "Zona horària desconeguda «%(tz)s»."

#, python-format
msgid "Updated: %(n)s"
msgstr "Actualitzades: %(n)s"

msgid "User"
msgstr "Usuari"

msgid "Web App"
msgstr "Aplicació web"

msgid "Write costs to TeslaMate now?"
msgstr "Escriure ara els costos a TeslaMate?"

msgid "pending"
msgstr "pendent"

msgid "— choose —"
msgstr "— trieu —"

