#, python-format
msgid "%(days)s: '%(price)s' is not a valid price."
msgstr "%(days)s: „%(price)s” nem érvényes ár."

#, python-format
msgid "%(field)s: '%(value)s' is not a valid number."
msgstr "%(field)s: „%(value)s” nem érvényes szám."

msgid "0 = only when you click “Calculate and save”."
msgstr "0 = csak a „Számítás és mentés” gombra kattintva."

msgid "Add location"
msgstr "Helyszín hozzáadása"

msgid "Add time block"
msgstr "Idősáv hozzáadása"

msgid "Another run is in progress, try again in a moment."
msgstr "Egy másik futás folyamatban van, próbálja újra kicsit később."

msgid "Automatic runs are off."
msgstr "Az automatikus futtatás ki van kapcsolva."

msgid "Back"
msgstr "Vissza"

msgid "By default the language of your browser is used, as in TeslaMate."
msgstr "Alapértelmezés szerint a böngésző nyelve érvényes, akárcsak a TeslaMate-ben."

msgid "Calculate and save"
msgstr "Számítás és mentés"

msgid ""
"Calculates the cost of every finished charge at your locations that has no cost yet. Existing "
"costs are never changed."
msgstr ""
"Kiszámítja minden olyan befejezett töltés költségét a helyszínein, amelyhez még nincs költség. A "
"meglévő költségek soha nem változnak."

msgid "Cancel"
msgstr "Mégse"

#, python-format
msgid "Cannot connect to the TeslaMate database: %(error)s"
msgstr "Nem sikerült csatlakozni a TeslaMate-adatbázishoz: %(error)s"

#, python-format
msgid "Cannot read sessions from the TeslaMate database: %(error)s"
msgstr "Nem sikerült beolvasni a töltéseket a TeslaMate-adatbázisból: %(error)s"

msgid "Charges"
msgstr "Töltések"

#, python-format
msgid "Charges to be updated: %(n)s"
msgstr "Frissítendő töltések: %(n)s"

msgid "Charging Costs"
msgstr "Töltési költségek"

msgid "Config is empty or not a mapping."
msgstr "A beállítás üres vagy érvénytelen."

#, python-format
msgid "Configuration problem: %(problem)s"
msgstr "Beállítási hiba: %(problem)s"

msgid "Coordinates are out of range."
msgstr "A koordináták kívül esnek a megengedett tartományon."

msgid "Cost"
msgstr "Költség"

msgid "Costs are converted to this currency using the ECB rate of the charging day."
msgstr "A költségek a töltés napi EKB-árfolyamon kerülnek átváltásra ebbe a pénznembe."

msgid "Costs saved"
msgstr "Költségek mentve"

msgid "Could not load geo-fences from TeslaMate."
msgstr "Nem sikerült betölteni a geokerítéseket a TeslaMate-ből."

msgid "Currency in TeslaMate"
msgstr "Pénznem a TeslaMate-ben"

msgid "Currency must be a 3-letter code, e.g. CZK."
msgstr "A pénznemnek 3 betűs kódnak kell lennie, pl. HUF."

msgid "Currency of your bill"
msgstr "A számla pénzneme"

msgid "Database"
msgstr "Adatbázis"

msgid "Delete"
msgstr "Törlés"

#, python-format
msgid "Delete %(name)s? Costs already written stay in TeslaMate."
msgstr "Törli: %(name)s? A már beírt költségek megmaradnak a TeslaMate-ben."

msgid "Edit"
msgstr "Szerkesztés"

msgid "End"
msgstr "Vége"

#, python-format
msgid "Errors: %(n)s"
msgstr "Hibák: %(n)s"

msgid "From"
msgstr "Ettől"

msgid "Geo-Fences"
msgstr "Geokerítések"

msgid "Host"
msgstr "Kiszolgáló"

msgid "Interval must be a number ≥ 0."
msgstr "Az intervallumnak ≥ 0 számnak kell lennie."

#, python-format
msgid "Invalid configuration: %(error)s"
msgstr "Érvénytelen beállítás: %(error)s"

msgid "Invalid or expired form token — reload the page and try again."
msgstr "Érvénytelen vagy lejárt űrlaptoken – töltse újra az oldalt, és próbálja újra."

msgid "Language"
msgstr "Nyelv"

msgid "Last 100 finished charges. kWh = energy taken from the grid."
msgstr "Az utolsó 100 befejezett töltés. kWh = a hálózatból vett energia."

#, python-format
msgid "Last run: %(time)s"
msgstr "Utolsó futás: %(time)s"

msgid "Latitude"
msgstr "Szélesség"

msgid "Loading…"
msgstr "Betöltés…"

msgid "Location"
msgstr "Helyszín"

#, python-format
msgid "Location '%(name)s' deleted."
msgstr "„%(name)s” helyszín törölve."

#, python-format
msgid ""
"Location '%(name)s' has no timezone. Set a default timezone (e.g. Europe/Prague) or one for the "
"location."
msgstr ""
"A(z) „%(name)s” helyszínnek nincs időzónája. Állítson be alapértelmezett időzónát (pl. "
"Europe/Budapest) vagy egyet a helyszínhez."

#, python-format
msgid "Location '%(name)s' saved."
msgstr "„%(name)s” helyszín mentve."

#, python-format
msgid ""
"Location '%(name)s', %(days)s: block %(block)s must start before it ends. Split blocks crossing "
"midnight into two (…–24:00 and 00:00–…)."
msgstr ""
"„%(name)s” helyszín, %(days)s: a(z) %(block)s sávnak a vége előtt kell kezdődnie. Az éjfélen "
"átnyúló sávokat ossza kettőre (…–24:00 és 00:00–…)."

#, python-format
msgid "Location '%(name)s', %(days)s: invalid block %(block)s. Expected from and to as HH:MM and a price."
msgstr ""
"„%(name)s” helyszín, %(days)s: érvénytelen sáv: %(block)s. Kezdés és befejezés ÓÓ:PP formában, "
"valamint ár szükséges."

#, python-format
msgid "Location '%(name)s', %(days)s: negative price in block %(block)s."
msgstr "„%(name)s” helyszín, %(days)s: negatív ár a(z) %(block)s sávban."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariff after %(time)s (the last block must end at 24:00)."
msgstr ""
"„%(name)s” helyszín, %(days)s: %(time)s után nincs tarifa (az utolsó sávnak 24:00-kor kell "
"végződnie)."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariff between %(start)s and %(end)s."
msgstr "„%(name)s” helyszín, %(days)s: nincs tarifa %(start)s és %(end)s között."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariffs defined."
msgstr "„%(name)s” helyszín, %(days)s: nincs megadva tarifa."

#, python-format
msgid "Location '%(name)s', %(days)s: overlapping blocks around %(time)s."
msgstr "„%(name)s” helyszín, %(days)s: átfedő sávok %(time)s körül."

#, python-format
msgid "Location '%(name)s': missing '%(key)s'."
msgstr "„%(name)s” helyszín: hiányzik: „%(key)s”."

#, python-format
msgid "Location '%(name)s': missing 'timezone'."
msgstr "„%(name)s” helyszín: hiányzik az időzóna."

#, python-format
msgid "Location '%(name)s': unknown timezone '%(tz)s'."
msgstr "„%(name)s” helyszín: ismeretlen időzóna: „%(tz)s”."

msgid "Location names must be unique."
msgstr "A helyszínek nevének egyedinek kell lennie."

msgid "Locations"
msgstr "Helyszínek"

msgid "Login required"
msgstr "Bejelentkezés szükséges"

msgid "Longitude"
msgstr "Hosszúság"

#, python-format
msgid "Missing '%(key)s'."
msgstr "Hiányzik: „%(key)s”."

msgid "Monday – Friday"
msgstr "Hétfő – péntek"

msgid "Name"
msgstr "Név"

msgid "Name is required."
msgstr "A név megadása kötelező."

msgid "New location"
msgstr "Új helyszín"

#, python-format
msgid "Next run: %(time)s"
msgstr "Következő futás: %(time)s"

msgid "No geo-fences in TeslaMate"
msgstr "Nincs geokerítés a TeslaMate-ben"

msgid "No locations yet. Add your home (or any private charger) and its electricity tariff."
msgstr "Még nincs helyszín. Adja hozzá az otthonát (vagy bármely magántöltőt) és annak áramtarifáját."

#, python-format
msgid "No password set — anyone who can reach this page can change your tariffs. Set %(var)s."
msgstr ""
"Nincs jelszó beállítva – bárki, aki eléri ezt az oldalt, módosíthatja a tarifáit. Állítsa be: "
"%(var)s."

msgid "No price"
msgstr "Nincs ár"

msgid "Overlap"
msgstr "Átfedés"

msgid "Per kWh"
msgstr "kWh-nként"

msgid "Pick a TeslaMate geo-fence to fill in name, coordinates and radius."
msgstr "Válasszon egy TeslaMate geokerítést a név, a koordináták és a sugár kitöltéséhez."

msgid "Preview"
msgstr "Előnézet"

msgid "Private charging"
msgstr "Magántöltés"

msgid "Radius"
msgstr "Sugár"

msgid "Radius must be positive."
msgstr "A sugárnak pozitívnak kell lennie."

msgid "Remove"
msgstr "Eltávolítás"

msgid "Run automatically every (hours)"
msgstr "Automatikus futtatás (óránként)"

#, python-format
msgid "Runs automatically every %(hours)s h."
msgstr "Automatikusan fut %(hours)s óránként."

msgid "Same as Monday – Friday"
msgstr "Ugyanaz, mint hétfő – péntek"

msgid "Saturday – Sunday"
msgstr "Szombat – vasárnap"

msgid "Save"
msgstr "Mentés"

msgid "Save these costs"
msgstr "Költségek mentése"

#, python-format
msgid "Set with environment variables (%(vars)s), the same as in TeslaMate."
msgstr "Környezeti változókkal állítható be (%(vars)s), ugyanúgy, mint a TeslaMate-ben."

msgid "Settings"
msgstr "Beállítások"

msgid "Settings saved."
msgstr "Beállítások mentve."

msgid "Start"
msgstr "Kezdés"

msgid "Tariff times are local times in this time zone. Summer time is handled automatically."
msgstr ""
"A tarifák időpontjai ennek az időzónának a helyi idejében értendők. A nyári időszámítás "
"automatikus."

msgid "TeslaMate database"
msgstr "TeslaMate-adatbázis"

msgid "Time zone"
msgstr "Időzóna"

msgid ""
"Times are 24-hour (HH:MM); the last block ends at 24:00. A block over midnight (e.g. 22:00–06:00)"
" is entered as 22:00–24:00 and 00:00–06:00."
msgstr ""
"Az időpontok 24 órás formátumúak (ÓÓ:PP); az utolsó sáv 24:00-kor ér véget. Az éjfélen átnyúló "
"sávot (pl. 22:00–06:00) 22:00–24:00 és 00:00–06:00 formában adja meg."

msgid "To"
msgstr "Eddig"

msgid "Unavailable"
msgstr "Nem elérhető"

#, python-format
msgid "Unexpected error: %(error)s"
msgstr "Váratlan hiba: %(error)s"

#, python-format
msgid "Unknown timezone '%(tz)s'."
msgstr "Ismeretlen időzóna: „%(tz)s”."

#, python-format
msgid "Updated: %(n)s"
msgstr "Frissítve: %(n)s"

msgid "User"
msgstr "Felhasználó"

msgid "Web App"
msgstr "Webalkalmazás"

msgid "Write costs to TeslaMate now?"
msgstr "Beírja most a költségeket a TeslaMate-be?"

msgid "pending"
msgstr "függőben"

msgid "— choose —"
msgstr "— válasszon —"

