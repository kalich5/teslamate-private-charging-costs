#, python-format
msgid "%(days)s: '%(price)s' is not a valid price."
msgstr "%(days)s: ”%(price)s” är inte ett giltigt pris."

#, python-format
msgid "%(field)s: '%(value)s' is not a valid number."
msgstr "%(field)s: ”%(value)s” är inte ett giltigt tal."

msgid "0 = only when you click “Calculate and save”."
msgstr "0 = bara när du klickar på ”Beräkna och spara”."

msgid "Add location"
msgstr "Lägg till plats"

msgid "Add time block"
msgstr "Lägg till tidsblock"

msgid "Another run is in progress, try again in a moment."
msgstr "En annan körning pågår, försök igen om en stund."

msgid "Automatic runs are off."
msgstr "Automatiska körningar är avstängda."

msgid "Back"
msgstr "Tillbaka"

msgid "By default the language of your browser is used, as in TeslaMate."
msgstr "Som standard används webbläsarens språk, precis som i TeslaMate."

msgid "Calculate and save"
msgstr "Beräkna och spara"

msgid ""
"Calculates the cost of every finished charge at your locations that has no cost yet. Existing "
"costs are never changed."
msgstr ""
"Beräknar kostnaden för varje avslutad laddning på dina platser som ännu saknar kostnad. "
"Befintliga kostnader ändras aldrig."

msgid "Cancel"
msgstr "Avbryt"

#, python-format
msgid "Cannot connect to the TeslaMate database: %(error)s"
msgstr "Kan inte ansluta till TeslaMate-databasen: %(error)s"

#, python-format
msgid "Cannot read sessions from the TeslaMate database: %(error)s"
msgstr "Kan inte läsa laddningar från TeslaMate-databasen: %(error)s"

msgid "Charges"
msgstr "Laddningar"

#, python-format
msgid "Charges to be updated: %(n)s"
msgstr "Laddningar som uppdateras: %(n)s"

msgid "Charging Costs"
msgstr "Laddningskostnad"

msgid "Config is empty or not a mapping."
msgstr "Konfigurationen är tom eller ogiltig."

#, python-format
msgid "Configuration problem: %(problem)s"
msgstr "Konfigurationsproblem: %(problem)s"

msgid "Coordinates are out of range."
msgstr "Koordinaterna är utanför giltigt intervall."

msgid "Cost"
msgstr "Kostnad"

msgid "Costs are converted to this currency using the ECB rate of the charging day."
msgstr "Kostnaderna räknas om till denna valuta med ECB:s kurs på laddningsdagen."

msgid "Costs saved"
msgstr "Kostnader sparade"

msgid "Could not load geo-fences from TeslaMate."
msgstr "Det gick inte att läsa in geostaket från TeslaMate."

msgid "Currency in TeslaMate"
msgstr "Valuta i TeslaMate"

msgid "Currency must be a 3-letter code, e.g. CZK."
msgstr "Valutan måste vara en kod med 3 bokstäver, t.ex. SEK."

msgid "Currency of your bill"
msgstr "Valuta på din faktura"

msgid "Database"
msgstr "Databas"

msgid "Delete"
msgstr "Ta bort"

#, python-format
msgid "Delete %(name)s? Costs already written stay in TeslaMate."
msgstr "Ta bort %(name)s? Redan skrivna kostnader finns kvar i TeslaMate."

msgid "Edit"
msgstr "Redigera"

msgid "End"
msgstr "Slut"

#, python-format
msgid "Errors: %(n)s"
msgstr "Fel: %(n)s"

msgid "From"
msgstr "Från"

msgid "Geo-Fences"
msgstr "Geostaket"

msgid "Host"
msgstr "Värd"

msgid "Interval must be a number ≥ 0."
msgstr "Intervallet måste vara ett tal ≥ 0."

#, python-format
msgid "Invalid configuration: %(error)s"
msgstr "Ogiltig konfiguration: %(error)s"

msgid "Invalid or expired form token — reload the page and try again."
msgstr "Ogiltig eller utgången formulärtoken – ladda om sidan och försök igen."

msgid "Language"
msgstr "Språk"

msgid "Last 100 finished charges. kWh = energy taken from the grid."
msgstr "De senaste 100 avslutade laddningarna. kWh = energi från elnätet."

#, python-format
msgid "Last run: %(time)s"
msgstr "Senaste körning: %(time)s"

msgid "Latitude"
msgstr "Latitud"

msgid "Loading…"
msgstr "Laddar…"

msgid "Location"
msgstr "Plats"

#, python-format
msgid "Location '%(name)s' deleted."
msgstr "Platsen ”%(name)s” har tagits bort."

#, python-format
msgid ""
"Location '%(name)s' has no timezone. Set a default timezone (e.g. Europe/Prague) or one for the "
"location."
msgstr ""
"Platsen ”%(name)s” har ingen tidszon. Ange en standardtidszon (t.ex. Europe/Stockholm) eller en "
"för platsen."

#, python-format
msgid "Location '%(name)s' saved."
msgstr "Platsen ”%(name)s” har sparats."

#, python-format
msgid ""
"Location '%(name)s', %(days)s: block %(block)s must start before it ends. Split blocks crossing "
"midnight into two (…–24:00 and 00:00–…)."
msgstr ""
"Plats ”%(name)s”, %(days)s: blocket %(block)s måste börja innan det slutar. Dela block över "
"midnatt i två (…–24:00 och 00:00–…)."

#, python-format
msgid "Location '%(name)s', %(days)s: invalid block %(block)s. Expected from and to as HH:MM and a price."
msgstr ""
"Plats ”%(name)s”, %(days)s: ogiltigt block %(block)s. Förväntade start och slut som TT:MM och ett"
" pris."

#, python-format
msgid "Location '%(name)s', %(days)s: negative price in block %(block)s."
msgstr "Plats ”%(name)s”, %(days)s: negativt pris i blocket %(block)s."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariff after %(time)s (the last block must end at 24:00)."
msgstr "Plats ”%(name)s”, %(days)s: ingen tariff efter %(time)s (det sista blocket måste sluta 24:00)."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariff between %(start)s and %(end)s."
msgstr "Plats ”%(name)s”, %(days)s: ingen tariff mellan %(start)s och %(end)s."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariffs defined."
msgstr "Plats ”%(name)s”, %(days)s: inga tariffer angivna."

#, python-format
msgid "Location '%(name)s', %(days)s: overlapping blocks around %(time)s."
msgstr "Plats ”%(name)s”, %(days)s: överlappande block runt %(time)s."

#, python-format
msgid "Location '%(name)s': missing '%(key)s'."
msgstr "Plats ”%(name)s”: ”%(key)s” saknas."

#, python-format
msgid "Location '%(name)s': missing 'timezone'."
msgstr "Plats ”%(name)s”: tidszon saknas."

#, python-format
msgid "Location '%(name)s': unknown timezone '%(tz)s'."
msgstr "Plats ”%(name)s”: okänd tidszon ”%(tz)s”."

msgid "Location names must be unique."
msgstr "Platsnamn måste vara unika."

msgid "Locations"
msgstr "Platser"

msgid "Login required"
msgstr "Inloggning krävs"

msgid "Longitude"
msgstr "Longitud"

#, python-format
msgid "Missing '%(key)s'."
msgstr "”%(key)s” saknas."

msgid "Monday – Friday"
msgstr "Måndag – fredag"

msgid "Name"
msgstr "Namn"

msgid "Name is required."
msgstr "Namn krävs."

msgid "New location"
msgstr "Ny plats"

#, python-format
msgid "Next run: %(time)s"
msgstr "Nästa körning: %(time)s"

msgid "No geo-fences in TeslaMate"
msgstr "Inga geostaket i TeslaMate"

msgid "No locations yet. Add your home (or any private charger) and its electricity tariff."
msgstr "Inga platser ännu. Lägg till ditt hem (eller annan privat laddare) och dess eltariff."

#, python-format
msgid "No password set — anyone who can reach this page can change your tariffs. Set %(var)s."
msgstr "Inget lösenord angivet – alla som når den här sidan kan ändra dina tariffer. Ange %(var)s."

msgid "No price"
msgstr "Inget pris"

msgid "Overlap"
msgstr "Överlapp"

msgid "Per kWh"
msgstr "Per kWh"

msgid "Pick a TeslaMate geo-fence to fill in name, coordinates and radius."
msgstr "Välj ett geostaket från TeslaMate för att fylla i namn, koordinater och radie."

msgid "Preview"
msgstr "Förhandsgranska"

msgid "Private charging"
msgstr "Privat laddning"

msgid "Radius"
msgstr "Radie"

msgid "Radius must be positive."
msgstr "Radien måste vara positiv."

msgid "Remove"
msgstr "Ta bort"

msgid "Run automatically every (hours)"
msgstr "Kör automatiskt var (timmar)"

#, python-format
msgid "Runs automatically every %(hours)s h."
msgstr "Körs automatiskt var %(hours)s:e timme."

msgid "Same as Monday – Friday"
msgstr "Samma som måndag – fredag"

msgid "Saturday – Sunday"
msgstr "Lördag – söndag"

msgid "Save"
msgstr "Spara"

msgid "Save these costs"
msgstr "Spara dessa kostnader"

#, python-format
msgid "Set with environment variables (%(vars)s), the same as in TeslaMate."
msgstr "Anges med miljövariabler (%(vars)s), precis som i TeslaMate."

msgid "Settings"
msgstr "Inställningar"

msgid "Settings saved."
msgstr "Inställningar sparade."

msgid "Start"
msgstr "Start"

msgid "Tariff times are local times in this time zone. Summer time is handled automatically."
msgstr "Tariffernas tider är lokal tid i denna tidszon. Sommartid hanteras automatiskt."

msgid "TeslaMate database"
msgstr "TeslaMate-databas"

msgid "Time zone"
msgstr "Tidszon"

msgid ""
"Times are 24-hour (HH:MM); the last block ends at 24:00. A block over midnight (e.g. 22:00–06:00)"
" is entered as 22:00–24:00 and 00:00–06:00."
msgstr ""
"Tider anges i 24-timmarsformat (TT:MM); det sista blocket slutar 24:00. Ett block över midnatt "
"(t.ex. 22:00–06:00) anges som 22:00–24:00 och 00:00–06:00."

msgid "To"
msgstr "Till"

msgid "Unavailable"
msgstr "Inte tillgänglig"

#, python-format
msgid "Unexpected error: %(error)s"
msgstr "Oväntat fel: %(error)s"

#, python-format
msgid "Unknown timezone '%(tz)s'."
msgstr "Okänd tidszon ”%(tz)s”."

#, python-format
msgid "Updated: %(n)s"
msgstr "Uppdaterade: %(n)s"

msgid "User"
msgstr "Användare"

msgid "Web App"
msgstr "Webbapp"

msgid "Write costs to TeslaMate now?"
msgstr "Skriva kostnaderna till TeslaMate nu?"

msgid "pending"
msgstr "väntar"

msgid "— choose —"
msgstr "— välj —"

