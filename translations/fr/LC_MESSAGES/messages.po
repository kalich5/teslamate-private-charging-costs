#, python-format
msgid "%(days)s: '%(price)s' is not a valid price."
msgstr "%(days)s : « %(price)s » n'est pas un prix valide."

#, python-format
msgid "%(field)s: '%(value)s' is not a valid number."
msgstr "%(field)s : « %(value)s » n'est pas un nombre valide."

msgid "0 = only when you click “Calculate and save”."
msgstr "0 = uniquement en cliquant sur « Calculer et enregistrer »."

msgid "Add location"
msgstr "Ajouter un lieu"

msgid "Add time block"
msgstr "Ajouter une plage horaire"

msgid "Another run is in progress, try again in a moment."
msgstr "Une autre exécution est en cours, réessayez dans un instant."

msgid "Automatic runs are off."
msgstr "Les exécutions automatiques sont désactivées."

msgid "Back"
msgstr "Retour"

msgid "By default the language of your browser is used, as in TeslaMate."
msgstr "Par défaut, la langue de votre navigateur est utilisée, comme dans TeslaMate."

msgid "Calculate and save"
msgstr "Calculer et enregistrer"

msgid ""
"Calculates the cost of every finished charge at your locations that has no cost yet. Existing "
"costs are never changed."
msgstr ""
"Calcule le coût de chaque recharge terminée dans vos lieux qui n'en a pas encore. Les coûts "
"existants ne sont jamais modifiés."

msgid "Cancel"
msgstr "Annuler"

#, python-format
msgid "Cannot connect to the TeslaMate database: %(error)s"
msgstr "Impossible de se connecter à la base de données TeslaMate : %(error)s"

#, python-format
msgid "Cannot read sessions from the TeslaMate database: %(error)s"
msgstr "Impossible de lire les recharges depuis la base de données TeslaMate : %(error)s"

msgid "Charges"
msgstr "Recharges"

#, python-format
msgid "Charges to be updated: %(n)s"
msgstr "Recharges à mettre à jour : %(n)s"

msgid "Charging Costs"
msgstr "Coût de Charge"

msgid "Config is empty or not a mapping."
msgstr "La configuration est vide ou invalide."

#, python-format
msgid "Configuration problem: %(problem)s"
msgstr "Problème de configuration : %(problem)s"

msgid "Coordinates are out of range."
msgstr "Les coordonnées sont hors limites."

msgid "Cost"
msgstr "Coût"

msgid "Costs are converted to this currency using the ECB rate of the charging day."
msgstr "Les coûts sont convertis dans cette devise au taux BCE du jour de la recharge."

msgid "Costs saved"
msgstr "Coûts enregistrés"

msgid "Could not load geo-fences from TeslaMate."
msgstr "Impossible de charger les géorepérages depuis TeslaMate."

msgid "Currency in TeslaMate"
msgstr "Devise dans TeslaMate"

msgid "Currency must be a 3-letter code, e.g. CZK."
msgstr "La devise doit être un code à 3 lettres, par ex. EUR."

msgid "Currency of your bill"
msgstr "Devise de votre facture"

msgid "Database"
msgstr "Base de données"

msgid "Delete"
msgstr "Supprimer"

#, python-format
msgid "Delete %(name)s? Costs already written stay in TeslaMate."
msgstr "Supprimer %(name)s ? Les coûts déjà écrits restent dans TeslaMate."

msgid "Edit"
msgstr "Modifier"

msgid "End"
msgstr "Fin"

#, python-format
msgid "Errors: %(n)s"
msgstr "Erreurs : %(n)s"

msgid "From"
msgstr "De"

msgid "Geo-Fences"
msgstr "Géorepérages"

msgid "Host"
msgstr "Hôte"

msgid "Interval must be a number ≥ 0."
msgstr "L'intervalle doit être un nombre ≥ 0."

#, python-format
msgid "Invalid configuration: %(error)s"
msgstr "Configuration invalide : %(error)s"

msgid "Invalid or expired form token — reload the page and try again."
msgstr "Jeton de formulaire invalide ou expiré — rechargez la page et réessayez."

msgid "Language"
msgstr "Langue"

msgid "Last 100 finished charges. kWh = energy taken from the grid."
msgstr "Les 100 dernières recharges terminées. kWh = énergie prélevée sur le réseau."

#, python-format
msgid "Last run: %(time)s"
msgstr "Dernière exécution : %(time)s"

msgid "Latitude"
msgstr "Latitude"

msgid "Loading…"
msgstr "Chargement…"

msgid "Location"
msgstr "Lieu"

#, python-format
msgid "Location '%(name)s' deleted."
msgstr "Lieu « %(name)s » supprimé."

#, python-format
msgid ""
"Location '%(name)s' has no timezone. Set a default timezone (e.g. Europe/Prague) or one for the "
"location."
msgstr ""
"Le lieu « %(name)s » n'a pas de fuseau horaire. Définissez un fuseau par défaut (ex. "
"Europe/Paris) ou un fuseau pour ce lieu."

#, python-format
msgid "Location '%(name)s' saved."
msgstr "Lieu « %(name)s » enregistré."

#, python-format
msgid ""
"Location '%(name)s', %(days)s: block %(block)s must start before it ends. Split blocks crossing "
"midnight into two (…–24:00 and 00:00–…)."
msgstr ""
"Lieu « %(name)s », %(days)s : la plage %(block)s doit commencer avant de se terminer. Scindez les"
" plages passant minuit en deux (…–24:00 et 00:00–…)."

#, python-format
msgid "Location '%(name)s', %(days)s: invalid block %(block)s. Expected from and to as HH:MM and a price."
msgstr ""
"Lieu « %(name)s », %(days)s : plage invalide %(block)s. Début et fin au format HH:MM et un prix "
"sont attendus."

#, python-format
msgid "Location '%(name)s', %(days)s: negative price in block %(block)s."
msgstr "Lieu « %(name)s », %(days)s : prix négatif dans la plage %(block)s."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariff after %(time)s (the last block must end at 24:00)."
msgstr ""
"Lieu « %(name)s », %(days)s : aucun tarif après %(time)s (la dernière plage doit se terminer à "
"24:00)."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariff between %(start)s and %(end)s."
msgstr "Lieu « %(name)s », %(days)s : aucun tarif entre %(start)s et %(end)s."

#, python-format
msgid "Location '%(name)s', %(days)s: no tariffs defined."
msgstr "Lieu « %(name)s », %(days)s : aucun tarif défini."

#, python-format
msgid "Location '%(name)s', %(days)s: overlapping blocks around %(time)s."
msgstr "Lieu « %(name)s », %(days)s : plages qui se chevauchent vers %(time)s."

#, python-format
msgid "Location '%(name)s': missing '%(key)s'."
msgstr "Lieu « %(name)s » : « %(key)s » manquant."

#, python-format
msgid "Location '%(name)s': missing 'timezone'."
msgstr "Lieu « %(name)s » : fuseau horaire manquant."

#, python-format
msgid "Location '%(name)s': unknown timezone '%(tz)s'."
msgstr "Lieu « %(name)s » : fuseau horaire inconnu « %(tz)s »."

msgid "Location names must be unique."
msgstr "Les noms des lieux doivent être uniques."

msgid "Locations"
msgstr "Lieux"

msgid "Login required"
msgstr "Connexion requise"

msgid "Longitude"
msgstr "Longitude"

#, python-format
msgid "Missing '%(key)s'."
msgstr "« %(key)s » manquant."

msgid "Monday – Friday"
msgstr "Lundi – vendredi"

msgid "Name"
msgstr "Nom"

msgid "Name is required."
msgstr "Le nom est obligatoire."

msgid "New location"
msgstr "Nouveau lieu"

#, python-format
msgid "Next run: %(time)s"
msgstr "Prochaine exécution : %(time)s"

msgid "No geo-fences in TeslaMate"
msgstr "Aucun géorepérage dans TeslaMate"

msgid "No locations yet. Add your home (or any private charger) and its electricity tariff."
msgstr ""
"Aucun lieu pour l'instant. Ajoutez votre domicile (ou toute borne privée) et son tarif "
"d'électricité."

#, python-format
msgid "No password set — anyone who can reach this page can change your tariffs. Set %(var)s."
msgstr ""
"Aucun mot de passe défini — toute personne accédant à cette page peut modifier vos tarifs. "
"Définissez %(var)s."

msgid "No price"
msgstr "Pas de prix"

msgid "Overlap"
msgstr "Chevauchement"

msgid "Per kWh"
msgstr "Par kWh"

msgid "Pick a TeslaMate geo-fence to fill in name, coordinates and radius."
msgstr "Choisissez un géorepérage TeslaMate pour remplir le nom, les coordonnées et le rayon."

msgid "Preview"
msgstr "Aperçu"

msgid "Private charging"
msgstr "Recharge privée"

msgid "Radius"
msgstr "Rayon"

msgid "Radius must be positive."
msgstr "Le rayon doit être positif."

msgid "Remove"
msgstr "Retirer"

msgid "Run automatically every (hours)"
msgstr "Exécuter automatiquement toutes les (heures)"

#, python-format
msgid "Runs automatically every %(hours)s h."
msgstr "S'exécute automatiquement toutes les %(hours)s h."

msgid "Same as Monday – Friday"
msgstr "Identique au lundi – vendredi"

msgid "Saturday – Sunday"
msgstr "Samedi – dimanche"

msgid "Save"
msgstr "Enregistrer"

msgid "Save these costs"
msgstr "Enregistrer ces coûts"

#, python-format
msgid "Set with environment variables (%(vars)s), the same as in TeslaMate."
msgstr "Défini par des variables d'environnement (%(vars)s), comme dans TeslaMate."

msgid "Settings"
msgstr "Réglages"

msgid "Settings saved."
msgstr "Réglages enregistrés."

msgid "Start"
msgstr "Début"

msgid "Tariff times are local times in this time zone. Summer time is handled automatically."
msgstr ""
"Les heures des tarifs sont des heures locales de ce fuseau. L'heure d'été est gérée "
"automatiquement."

msgid "TeslaMate database"
msgstr "Base de données TeslaMate"

msgid "Time zone"
msgstr "Fuseau horaire"

msgid ""
"Times are 24-hour (HH:MM); the last block ends at 24:00. A block over midnight (e.g. 22:00–06:00)"
" is entered as 22:00–24:00 and 00:00–06:00."
msgstr ""
"Les heures sont au format 24 h (HH:MM) ; la dernière plage se termine à 24:00. Une plage passant "
"minuit (ex. 22:00–06:00) se saisit en 22:00–24:00 et 00:00–06:00."

msgid "To"
msgstr "À"

msgid "Unavailable"
msgstr "Indisponible"

#, python-format
msgid "Unexpected error: %(error)s"
msgstr "Erreur inattendue : %(error)s"

#, python-format
msgid "Unknown timezone '%(tz)s'."
msgstr "Fuseau horaire inconnu « %(tz)s »."

#, python-format
msgid "Updated: %(n)s"
msgstr "Mises à jour : %(n)s"

msgid "User"
msgstr "Utilisateur"

msgid "Web App"
msgstr "App Web"

msgid "Write costs to TeslaMate now?"
msgstr "Écrire les coûts dans TeslaMate maintenant ?"

msgid "pending"
msgstr "en attente"

msgid "— choose —"
msgstr "— choisir —"

